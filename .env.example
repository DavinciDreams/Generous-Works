# Example environment variables for all AI providers
# Replace values with your actual API keys before use

AI_GATEWAY_API_KEY=your-vercel-ai-gateway-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4
ZHIPU_MODEL=glm-4.7

# Optional read-only Galaxy Brain context integration.
# Create a Galaxy API key with only the eln:read scope and store its one-time
# gb_live_ value in Vercel. Never expose the key through NEXT_PUBLIC_*.
GALAXY_BRAIN_API_URL=https://galaxybrain.info/api/eln
GALAXY_BRAIN_API_TOKEN=gb_live_replace-with-read-only-key
GALAXY_BRAIN_WEB_URL=https://galaxybrain.info
GENEROUS_PUBLIC_URL=https://www.generous.works

# Optional bounded surface persistence. Use a separate Galaxy API key with
# eln:write scope; generated A2UI is saved as a draft before explicit promotion.
GALAXY_BRAIN_WRITE_TOKEN=gb_live_replace-with-write-key

# Optional dedicated HMAC secret for the signed Nostr link cookie. When omitted,
# CLERK_SECRET_KEY is used with domain separation so no additional secret is required.
GALAXY_BRAIN_LINK_SECRET=replace-with-at-least-32-random-bytes

# Optional recovery allowlist. Normal users connect with their Nostr identity;
# these exact Clerk IDs retain access if the cross-app link flow is unavailable.
GALAXY_BRAIN_ALLOWED_USER_IDS=user_replace-with-clerk-user-id

# Model selection for each provider
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_MODEL=claude-3-sonnet
GOOGLE_MODEL=gemini-pro

# MAF (Microsoft Agent Framework) Backend
# Set this to enable maf-standalone integration
NEXT_PUBLIC_MAF_URL=http://localhost:5555

# Clerk Authentication
# Get your keys from https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Clerk Routes (optional - customize sign-in/sign-up URLs)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Turbopack Optimization Environment Variables
# Enable Turbopack for development and production builds
TURBOPACK=1

# Turbopack cache directory (optional - defaults to .next/turbo)
# TURBOPACK_CACHE_DIR=.next/turbo

# Increase Turbopack memory limit for large projects (in MB)
# Default is 2048, increase if you encounter out-of-memory errors
TURBOPACK_MEMORY_LIMIT=4096

# Enable Turbopack's experimental features
# TURBOPACK_EXPERIMENTAL=1

# Turbopack parallel processing (default: true)
# TURBOPACK_PARALLEL=true

# Turbopack verbose logging for debugging
# TURBOPACK_VERBOSE=0
